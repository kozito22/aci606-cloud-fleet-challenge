# Copy to .env (never commit .env). Without DATABASE_URL the API uses data/fleet.db (SQLite).
# Neon: Dashboard -> Connect -> pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
MODEL_PATH=models/model.joblib
# Required to call POST /backups/run on a public deployment
BACKUP_TOKEN=change-me
# Backup schedule in minutes and retention
BACKUP_LOGICAL_MINUTES=30
BACKUP_PHYSICAL_MINUTES=360
BACKUP_KEEP=10
# Optional: off-site copy of physical backups (another disk / synced folder)
BACKUP_OFFSITE_DIR=
